{
  "name": "@fluency-education/scc",
  "version": "0.2.0",
  "description": "Create Standard Celeration Charts",
  "keywords": [
    "standard-celeration-chart",
    "precision-teaching",
    "chart"
  ],
  "license": "MIT",
  "author": "clayton-schneider",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluency-education/scc.git"
  },
  "homepage": "https://github.com/fluency-education/scc#readme",
  "bugs": "https://github.com/fluency-education/scc/issues",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "preview": "npm run build && node scripts/preview.js",
    "example": "npm run build && node scripts/example.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "bench": "npm run build && node scripts/bench.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
